{
  "name": "@bactv/vue-calendar-heatmap",
  "version": "1.0.0",
  "description": "A GitHub-style calendar heatmap component for Vue 3, written in TypeScript.",
  "type": "module",
  "main": "./dist/calendar-heatmap.umd.cjs",
  "module": "./dist/calendar-heatmap.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/calendar-heatmap.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/calendar-heatmap.es.js",
      "require": "./dist/calendar-heatmap.umd.cjs"
    },
    "./style.css": "./dist/calendar-heatmap.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "calendar",
    "heatmap",
    "calendar-heatmap",
    "github-contributions",
    "activity-graph"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.build.json --noEmit && vite build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bactvdev/vue-calendar-heatmap"
  }
}
